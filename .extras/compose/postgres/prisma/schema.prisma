generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model firma {
  id                Int                @id @default(autoincrement())
  version           Int                @default(0)
  name              String             @unique
  gruendungsjahr    Int?
  branche           String?
  mitarbeiteranzahl Int?
  umsatz            Decimal?           @db.Decimal(12, 2)
  homepage          String?
  erzeugt           DateTime           @default(now()) @db.Timestamp(6)
  aktualisiert      DateTime           @default(now()) @db.Timestamp(6)
  firma_file        firma_file?
  geschaeftsfuehrer geschaeftsfuehrer?
  standort          standort[]
}

model firma_file {
  id       Int     @id @default(autoincrement())
  data     Bytes
  filename String
  mimetype String?
  firma_id Int     @unique
  firma    firma   @relation(fields: [firma_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([firma_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model geschaeftsfuehrer {
  id       Int     @id @default(autoincrement())
  name     String
  email    String?
  telefon  String?
  firma_id Int     @unique
  firma    firma   @relation(fields: [firma_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model standort {
  id       Int    @id @default(autoincrement())
  adresse  String
  plz      String
  ort      String
  land     String
  firma_id Int
  firma    firma  @relation(fields: [firma_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([firma_id])
}
