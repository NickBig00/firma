generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["firma"]

}

model Firma {
  id                Int                 @id @default(autoincrement())
  version           Int                 @default(0)
  name              String              @unique
  gruendungsjahr    Int?
  branche           String?
  mitarbeiteranzahl Int?
  umsatz            Decimal?            @db.Decimal(12, 2)
  homepage          String?
  erzeugt           DateTime            @default(now()) @db.Timestamp(6)
  aktualisiert      DateTime            @default(now()) @updatedAt @db.Timestamp(6)
  firmaFile         FirmaFile?
  geschaeftsfuehrer Geschaeftsfuehrer?
  standorte         Standort[]

  @@map("firma")
  @@schema("firma")

}

model FirmaFile {
  id        Int      @id @default(autoincrement())
  data      Bytes
  filename  String
  mimetype  String?
  firmaId   Int      @unique @map("firma_id")
  firma     Firma    @relation(fields: [firmaId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([firmaId])
  @@map("firma_file")
  @@schema("firma")
}

model Geschaeftsfuehrer {
  id       Int     @id @default(autoincrement())
  name     String
  email    String?
  telefon  String?
  firmaId  Int     @unique @map("firma_id")
  firma    Firma   @relation(fields: [firmaId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("geschaeftsfuehrer")
  @@schema("firma")

}

model Standort {
  id       Int     @id @default(autoincrement())
  adresse  String
  plz      String
  ort      String
  land     String
  firmaId  Int     @map("firma_id")
  firma    Firma   @relation(fields: [firmaId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([firmaId])
  @@map("standort")
  @@schema("firma")
}
